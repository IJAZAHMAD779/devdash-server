{
  "name": "devdash-server",
  "version": "1.0.0",
  "description": "DevDash REST API server built with Express, TypeScript, and Prisma",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "devdash",
    "express",
    "prisma",
    "clerk",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@clerk/backend": "^3.25.0",
    "@clerk/express": "^2.1.80",
    "@prisma/client": "^5.22.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "prisma": "^5.22.0",
    "resend": "^6.34.1",
    "typescript": "^5.7.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "tsx": "^4.19.3"
  }
}

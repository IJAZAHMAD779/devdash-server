datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ComponentFramework {
  REACT
  NEXTJS
  VUE
  SVELTE
  HTML_CSS
}

enum ComponentStyling {
  TAILWIND
  CSS_MODULES
  VANILLA_CSS
  STYLED_COMPONENTS
}

enum BookmarkCategory {
  DOCS
  ARTICLE
  TOOL
  LIBRARY
  VIDEO
  TUTORIAL
}

enum ActivityAction {
  CREATED
  UPDATED
  DELETED
  COMPLETED
}

enum ActivityEntityType {
  PROJECT
  TASK
  SNIPPET
  COMPONENT
  BOOKMARK
  NOTE
}

// -------------------------------------------------------------
// MODELS
// -------------------------------------------------------------

model User {
  id        String   @id // Clerk User ID (e.g., "user_2xxxxxxx")
  email     String   @unique
  name      String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects      Project[]
  tasks         Task[]
  snippets      Snippet[]
  components    UIComponent[]
  bookmarks     Bookmark[]
  notes         Note[]
  activityLogs  ActivityLog[]
  reminders     Reminder[]

  @@map("users")
}

model Project {
  id             String        @id @default(uuid())
  userId         String
  title          String
  description    String?       @db.Text
  status         ProjectStatus @default(PLANNING)
  repositoryUrl  String?
  liveUrl        String?
  techStack      String[]      @default([])
  favorite       Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks          Task[]
  snippets       Snippet[]
  components     UIComponent[]
  bookmarks      Bookmark[]
  notes          Note[]

  @@index([userId])
  @@index([userId, status])
  @@map("projects")
}

model Task {
  id          String     @id @default(uuid())
  userId      String
  projectId   String?
  title       String
  description String?    @db.Text
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  reminders   Reminder[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, priority])
  @@index([projectId])
  @@map("tasks")
}

model Snippet {
  id          String   @id @default(uuid())
  userId      String
  projectId   String?
  title       String
  description String?  @db.Text
  language    String   // e.g. "typescript", "python", "sql", "bash"
  code        String   @db.Text
  tags        String[] @default([])
  favorite    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, language])
  @@index([projectId])
  @@map("snippets")
}

model UIComponent {
  id          String             @id @default(uuid())
  userId      String
  projectId   String?
  name        String
  description String?            @db.Text
  framework   ComponentFramework @default(REACT)
  styling     ComponentStyling   @default(TAILWIND)
  code        String             @db.Text
  previewCode String?            @db.Text
  tags        String[]           @default([])
  favorite    Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, framework])
  @@index([projectId])
  @@map("ui_components")
}

model Bookmark {
  id        String           @id @default(uuid())
  userId    String
  projectId String?
  title     String
  url       String
  category  BookmarkCategory @default(DOCS)
  tags      String[]         @default([])
  notes     String?          @db.Text
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, category])
  @@index([projectId])
  @@map("bookmarks")
}

model Note {
  id        String   @id @default(uuid())
  userId    String
  projectId String?
  title     String
  content   String   @db.Text // Full Markdown content
  tags      String[] @default([])
  favorite  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@map("notes")
}

model ActivityLog {
  id         String             @id @default(uuid())
  userId     String
  entityType ActivityEntityType
  entityId   String
  action     ActivityAction
  title      String
  createdAt  DateTime           @default(now())

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("activity_logs")
}

model Reminder {
  id          String    @id @default(uuid())
  userId      String
  title       String
  description String?   @db.Text
  remindAt    DateTime
  isSent      Boolean   @default(false)
  sentAt      DateTime?
  taskId      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  task        Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([remindAt, isSent])
  @@map("reminders")
}
